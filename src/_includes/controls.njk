{# Appearance and palette, stacked. Hidden until the scripts run: without JS
   neither button does anything, and the page still follows the system
   appearance on its own. #}
<div class="controls" hidden>
  <button type="button" id="theme-toggle" class="icon-btn" aria-label="Switch appearance">
    <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"></svg>
  </button>

  <button type="button" id="palette-btn" class="icon-btn" aria-label="Colour theme"
          title="Colour theme" aria-expanded="false" aria-controls="palette-panel">
    {# SF Symbols paintpalette #}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1.5c3.6 0 6.5 2.5 6.5 5.7 0 1.9-1.5 3-3 3h-1.2c-.8 0-1.4.6-1.4 1.3 0 .3.1.5.3.8.2.2.3.5.3.7 0 .7-.6 1.3-1.5 1.3A6.5 6.5 0 0 1 8 1.5Z"
            stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <circle cx="4.9" cy="6.5" r="1" fill="currentColor"/>
      <circle cx="7.9" cy="4.7" r="1" fill="currentColor"/>
      <circle cx="11" cy="6.6" r="1" fill="currentColor"/>
    </svg>
  </button>

  <div class="palette-panel" id="palette-panel" hidden>
    <div class="palette-grid" role="listbox" aria-label="Colour theme">
      {# Each swatch is split light/dark, because a palette carries both. #}
      <button type="button" class="swatch is-default" data-palette="" role="option"
              aria-selected="false" title="Default" aria-label="Default"></button>
      {%- for t in palettes.themes %}
      <button type="button" class="swatch" data-palette="{{ t.id }}" role="option"
              aria-selected="false" title="{{ t.name }}" aria-label="{{ t.name }}"
              style="--sw-l:{{ t.light.bg }};--sw-d:{{ t.dark.bg }};--sw-p:{{ t.dark.primary }}"></button>
      {%- endfor %}
    </div>
  </div>
</div>
