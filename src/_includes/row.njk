{% from "avatar.njk" import portrait %}
{#- One conversation-list row. Shared by the index and the tag pages. -#}
<li class="row"
    data-date="{{ post.date | isoDate }}"
    data-text="{{ post.data.title | searchText(post.data.summary, post.data.tags | userTags | join(' '), post.templateContent) }}">
  <a class="row-link" href="{{ post.url }}">
    {%- set who = post.data.author if post.data.author else site.author %}
    {{ portrait(who, "row-avatar", 52, lazy=true) }}
    <span class="row-body">
      <span class="row-top">
        <span class="row-title">{{ post.data.title }}</span>
        <span class="row-date">{{ post.date | shortDate }}<svg width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true"><path d="M1.2 1 6 6l-4.8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </span>
      {# Prefer the hand-written summary when there is one; it says what the
         post is about rather than just showing its opening words. #}
      <span class="row-preview">{{ post.data.summary | preview if post.data.summary else post.templateContent | preview }}</span>
    </span>
  </a>
</li>
