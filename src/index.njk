---
layout: base.njk
bodyClass: inbox
eleventyExcludeFromCollections: true
---
<main class="screen screen-list">
  <header class="list-head">
    <div class="list-head-text">
      <h1>{{ site.title }}</h1>
      <p class="list-sub">{{ collections.posts | length }} post{{ "" if collections.posts | length == 1 else "s" }} from {{ site.author }}</p>
    </div>
    {% include "controls.njk" %}
  </header>

  {# Activity graph: a row per month, a column per day of the month, so it
     fits the column at any width without scrolling. Hidden until the script
     runs, since clicking a day only does something with JavaScript. #}
  <div class="activity" id="activity" hidden>
    <div class="activity-months" role="group"
         aria-label="Posts by day. Select a day to jump to it.">
      {%- for m in activity.months %}
      <div class="amonth">
        <span class="amonth-name" aria-hidden="true">{{ m.name }}</span>
        <div class="amonth-days" style="--cols:{{ activity.maxDays }}">
          {%- for d in m.days %}
          {%- if d.count %}
          <button type="button" class="day day-on" data-day="{{ d.iso }}"
                  data-page="{{ collections.posts | pageForDate(d.iso, site.perPage) }}"
                  title="{{ d.label }}" aria-label="{{ d.label }}"></button>
          {%- else %}
          <span class="day" title="{{ d.label }}"></span>
          {%- endif %}
          {%- endfor %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>

  {#- Not hidden like the graph and the tools: it is a plain link, so it works
      with JavaScript off. Only shown once something is actually tagged. #}
  {%- if collections.tagList | length %}
  <a class="index-link" href="/tags/">
    {# SF Symbols tag #}
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M13.8 2.2H9.4a1.3 1.3 0 0 0-.92.38l-6.1 6.1a1.3 1.3 0 0 0 0 1.84l3.1 3.1a1.3 1.3 0 0 0 1.84 0l6.1-6.1a1.3 1.3 0 0 0 .38-.92V2.2Z"
            stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="11.1" cy="4.9" r="1.05" fill="currentColor"/>
    </svg>
    Tags index
    <span class="index-link-sub">{{ collections.tagList | length }} tags</span>
  </a>
  {%- endif %}

  {# Hidden until the script takes over: without JS none of it would do anything. #}
  <div class="tools" id="tools" hidden>
    <div class="tools-row">
      <div class="search">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.2" stroke="currentColor" stroke-width="1.7"/>
          <path d="M11 11l4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
        <input type="search" id="q" placeholder="Search"
               aria-label="Search posts, or type a date like 5/21/26 or a range like 5/1/26 to 5/15/26"
               aria-describedby="result-count"
               autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
      </div>

      {# SF Symbols arrow.up.arrow.down #}
      <button type="button" id="sort" class="sort-btn" aria-label="Sort by date, newest first. Activate to reverse.">
        <svg width="15" height="16" viewBox="0 0 15 16" fill="none" aria-hidden="true">
          <path d="M4 13.2V3.4M1.6 5.8 4 3.2l2.4 2.6" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M11 2.8v9.8M8.6 10.2l2.4 2.6 2.4-2.6" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span id="sort-label">Newest</span>
      </button>
    </div>

    <p class="result-count" id="result-count" role="status" aria-live="polite"></p>
  </div>

  <ul class="rows" id="post-list" data-page="{{ pagination.pageNumber + 1 }}" data-pages="{{ pagination.pages | length }}">
    {% for post in pagePosts %}
    {% include "row.njk" %}
    {% endfor %}
  </ul>

  <p class="no-match" id="no-match" hidden>No posts match.</p>

  {#- Horizontal, unlike the pager on a post: left is newer, right is older,
      which is the order the list already reads in. Only rendered when there
      is more than one page. #}
  {%- if pagination.pages | length > 1 %}
  <nav class="pagenav" aria-label="Pages">
    {%- if pagination.href.previous %}
    <a class="pagenav-link" href="{{ pagination.href.previous }}" rel="prev">&larr; Newer</a>
    {%- else %}<span class="pagenav-end"></span>{% endif %}
    <span class="pagenav-at">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages | length }}</span>
    {%- if pagination.href.next %}
    <a class="pagenav-link" href="{{ pagination.href.next }}" rel="next">Older &rarr;</a>
    {%- else %}<span class="pagenav-end"></span>{% endif %}
  </nav>
  {%- endif %}
</main>

{# Appears once the reader has scrolled; hidden by default so no-JS visitors
   never see a control that does nothing. #}
<button type="button" id="to-top" class="to-top" hidden aria-label="Back to top">
  {# SF Symbols chevron.up #}
  <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
    <path d="M4 10.5 8.5 6l4.5 4.5" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</button>

<script src="/assets/js/search.js" defer></script>
